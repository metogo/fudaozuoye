# 必须显式选择运行模式。默认使用真实模型；如需内置代表题演示，改为 true。
# 演示模式不识别自定义图片，不会用固定样题代替上传内容。
AI_MOCK_MODE=false

# 生产环境必填：至少 32 位随机字符串，用于加密无数据库会话。
SESSION_STATE_SECRET=

# 首页真实统计必填，仅供服务端使用。不得使用 NEXT_PUBLIC_ 前缀。
# CloudBase 服务端 API Key 是环境管理员身份，不能填写客户端 Publishable Key。
# 真实值只放入 Git 忽略的 .env.local；不要提交或打印密钥。
CLOUDBASE_ENV_ID=
CLOUDBASE_APIKEY=

# AI_MOCK_MODE=false 时，本地启动至少需要下面两项。
DOUBAO_API_KEY=
DOUBAO_MODEL_ID=
DOUBAO_MODEL_ID_MEDIUM=
DOUBAO_MODEL_ID_HIGH=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 可选：启用“插画演示”。图片模型复用 DOUBAO_API_KEY。
DOUBAO_IMAGE_MODEL_ID=
DOUBAO_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_BASE_URL=https://api.openai.com/v1/responses

XAI_API_KEY=
XAI_MODEL_ID=
XAI_BASE_URL=https://api.x.ai/v1/responses
