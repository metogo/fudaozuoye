# 默认 true：无需密钥即可体验完整闭环。接真实模型时设为 false。
AI_MOCK_MODE=true

# 生产环境必填：至少 32 位随机字符串，用于加密无数据库会话。
SESSION_STATE_SECRET=

DOUBAO_API_KEY=
DOUBAO_MODEL_ID=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_BASE_URL=https://api.openai.com/v1/responses

XAI_API_KEY=
XAI_MODEL_ID=
XAI_BASE_URL=https://api.x.ai/v1/responses
