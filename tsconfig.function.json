{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "functions/learning-api/dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": [
    "functions/learning-api/src/**/*.ts",
    "lib/learning/**/*.ts"
  ]
}
